# Database
DATABASE_URL="postgresql://jmart_user:jmart_pass@localhost:5432/jmart_db?schema=public"
DATABASE_DIRECT_URL="postgresql://jmart_user:jmart_pass@localhost:5432/jmart_db?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=jmart_redis_pass

# JWT
JWT_ACCESS_SECRET=your_access_token_secret_min_32_chars_here
JWT_REFRESH_SECRET=your_refresh_token_secret_min_32_chars_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# App
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_NAME=Jmart API
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# File Storage (S3-compatible)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=jmart-files
STORAGE_REGION=us-east-1

# Google Maps
GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# Email (SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@jmart.sa

# SMS (optional)
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=

# FCM Push Notifications
FCM_SERVER_KEY=

# Platform
PLATFORM_COMMISSION_DEFAULT=0.03
DISPUTE_WINDOW_HOURS=4
PRICE_LOCK_MINUTES=15
