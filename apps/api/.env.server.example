# ─────────────────────────────────────────────────────────────────────────────
# Server environment template — copy to apps/api/.env.server ON THE SERVER
# (NOT on your laptop) and fill in real secrets. .env.server is gitignored.
#
# Generate strong secrets with:
#   openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

# Database (points at the postgres container on the docker network, NOT host)
DATABASE_URL="postgresql://jmart_user:CHANGE_ME_DB_PASS@postgres:5432/jmart_db?schema=public"
DATABASE_DIRECT_URL="postgresql://jmart_user:CHANGE_ME_DB_PASS@postgres:5432/jmart_db?schema=public"

# Redis (container)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASS

# JWT — MUST be 64+ random chars each, DIFFERENT from each other
JWT_ACCESS_SECRET=CHANGE_ME_run_openssl_rand_hex_32_AND_PASTE_HERE
JWT_REFRESH_SECRET=CHANGE_ME_run_openssl_rand_hex_32_AND_PASTE_HERE_DIFFERENT
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# App
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1
APP_NAME=Jmart API

# CORS — allow only your frontends
CORS_ORIGINS=http://62.171.147.73:8102,http://62.171.147.73:8103,http://62.171.147.73:8104

# File Storage (MinIO container)
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=CHANGE_ME_MINIO_KEY
STORAGE_SECRET_KEY=CHANGE_ME_MINIO_SECRET
STORAGE_BUCKET=jmart-files
STORAGE_REGION=us-east-1

# Google Maps (optional)
GOOGLE_MAPS_API_KEY=

# Email (optional — leave blank to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@jmart.sa

# SMS (optional)
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=

# Platform
PLATFORM_COMMISSION_DEFAULT=0.03
DISPUTE_WINDOW_HOURS=4
PRICE_LOCK_MINUTES=15
