// ─────────────────────────────────────────────────────────────────────────
// ShipmentBid — open marketplace for independent drivers to bid on shipments.
//
// Flow:
//   1. Order CONFIRMED + requires shipping → Shipment created (AWAITING_BIDS)
//   2. System notifies eligible drivers (zone match, vehicle capacity)
//   3. Each driver submits ONE bid with their price + ETA
//   4. Buyer reviews bids and accepts one → other bids auto-rejected
//   5. Shipment.driverId set, status → DRIVER_ASSIGNED
//
// Constraints:
//   - One PENDING bid per (shipment, driver) — enforced by @@unique
//   - Bid amount must be positive; service validates
//   - Driver can WITHDRAW their own pending bid
// ─────────────────────────────────────────────────────────────────────────
enum ShipmentBidStatus {
  PENDING       // Driver submitted, awaiting buyer decision
  ACCEPTED      // Buyer chose this bid — shipment assigned to this driver
  REJECTED      // Buyer chose a different bid, or system auto-rejected
  WITHDRAWN     // Driver retracted before any decision
  EXPIRED       // Buyer didn't decide in time
}

model ShipmentBid {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shipmentId          String            @db.Uuid
  driverId            String            @db.Uuid
  quotedPrice         Decimal           @db.Decimal(15, 2)
  estimatedPickupAt   DateTime?
  estimatedDeliveryAt DateTime?
  vehicleType         VehicleType?
  capacityKg          Decimal?          @db.Decimal(10, 2)
  notes               String?
  status              ShipmentBidStatus @default(PENDING)
  decidedAt           DateTime?
  decidedById         String?           @db.Uuid     // buyer who accepted/rejected
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  shipment            Shipment          @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  driver              Driver            @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, driverId], name: "unique_driver_bid_per_shipment")
  @@index([shipmentId, status])
  @@index([driverId, status])
  @@map("shipment_bids")
}

