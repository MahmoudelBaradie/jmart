  driverId            String?      @db.Uuid
  buyerId             String?      @db.Uuid
  orderId             String?      @db.Uuid
  invoiceId           String?      @db.Uuid
  grossAmount         Decimal      @db.Decimal(15, 2)
  commissionDeducted  Decimal      @default(0) @db.Decimal(15, 2)
  penaltiesDeducted   Decimal      @default(0) @db.Decimal(15, 2)
  netAmount           Decimal      @db.Decimal(15, 2)
  currency            String       @default("SAR") @db.VarChar(3)
  recipientIban       String?      @db.VarChar(34)
  status              PayoutStatus @default(QUEUED)
  approvedById        String?      @db.Uuid
  approvedAt          DateTime?
  processedAt         DateTime?
