  @@map("escalations")
}

model ApprovalRequest {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  approvalNumber  String         @unique @db.VarChar(50)
  approvalType    String         @db.VarChar(100)
  referenceId     String         @db.Uuid
  referenceType   String         @db.VarChar(50)
  requestedById   String         @db.Uuid
  currentApproverId String?      @db.Uuid
  approvalFlow    Json
  currentLevel    Int            @default(1)
  status          ApprovalStatus @default(PENDING)
  justification   String?
  finalDecisionAt DateTime?
  finalDecisionById String?      @db.Uuid
  rejectionReason String?
  expiresAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  requestedBy     InternalUser   @relation("ApprovalRequester", fields: [requestedById], references: [id])
  finalDecisionBy InternalUser?  @relation("ApprovalDecider", fields: [finalDecisionById], references: [id])

  @@map("approval_requests")
}

// ═══════════════════════════════════════════════════════════
// NOTIFICATION MODULE
// ═══════════════════════════════════════════════════════════

model Notification {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientId      String   @db.Uuid
  recipientType    String   @db.VarChar(50)
  notificationType String   @db.VarChar(100)
  title            String   @db.VarChar(255)
  body             String
  data             Json?
  priority         String   @default("NORMAL") @db.VarChar(10)
  channels         String[]
  isRead           Boolean  @default(false)
  readAt           DateTime?
  createdAt        DateTime @default(now())

  user             User?    @relation(fields: [recipientId], references: [id])
  deliveries       NotificationDelivery[]

  @@index([recipientId, recipientType, isRead])
  @@index([createdAt(sort: Desc)])
  @@map("notifications")
}

model NotificationDelivery {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId String         @db.Uuid
  channel        NotificationChannel
  status         DeliveryStatus @default(PENDING)
  sentAt         DateTime?
  deliveredAt    DateTime?
  failureReason  String?
  retryCount     Int            @default(0)

  notification   Notification   @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@map("notification_deliveries")
}

model CommunicationLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  senderId     String   @db.Uuid
  senderType   String   @db.VarChar(50)
  recipientId  String   @db.Uuid
  recipientType String  @db.VarChar(50)
  channel      String   @db.VarChar(50)
  subject      String?  @db.VarChar(255)
  content      String
  referenceId  String?  @db.Uuid
  referenceType String? @db.VarChar(50)
  sentAt       DateTime @default(now())

  @@index([referenceId, referenceType])
  @@map("communication_logs")
}

// ═══════════════════════════════════════════════════════════
// AUDIT MODULE
// ═══════════════════════════════════════════════════════════

model AuditLog {
  id            BigInt      @id @default(autoincrement())
  auditId       String      @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  timestamp     DateTime    @default(now())
  actorId       String?     @db.Uuid
  actorType     String?     @db.VarChar(50)
  actionType    AuditAction
  entityType    String      @db.VarChar(100)
  entityId      String      @db.Uuid
  oldValue      Json?
  newValue      Json?
  changeDelta   Json?
  ipAddress     String?     @db.VarChar(45)
  userAgent     String?
  sessionId     String?     @db.VarChar(255)
  reason        String?
  relatedAuditId String?    @db.Uuid

  @@index([entityType, entityId])
  @@index([actorId, timestamp(sort: Desc)])
  @@index([timestamp(sort: Desc)])
  @@map("audit_logs")
}

model ActivityLog {
  id              BigInt   @id @default(autoincrement())
  entityType      String   @db.VarChar(100)
  entityId        String   @db.Uuid
  activityType    String   @db.VarChar(100)
  performedById   String?  @db.Uuid
  performedByType String?  @db.VarChar(50)
  summary         String
  metadata        Json?
  createdAt       DateTime @default(now())

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@map("activity_logs")
}

// ═══════════════════════════════════════════════════════════
// RATINGS MODULE
// ═══════════════════════════════════════════════════════════

model Rating {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  raterId     String   @db.Uuid
  raterType   String   @db.VarChar(50)
  ratedId     String   @db.Uuid
  ratedType   String   @db.VarChar(50)
  farmerId    String?  @db.Uuid
  buyerId     String?  @db.Uuid
  driverId    String?  @db.Uuid
  orderId     String?  @db.Uuid
  score       Decimal  @db.Decimal(3, 2)
  comment     String?
  createdAt   DateTime @default(now())

  farmer      Farmer?  @relation("FarmerRatings", fields: [farmerId], references: [id])
  buyer       Buyer?   @relation("BuyerRatings", fields: [buyerId], references: [id])
  driver      Driver?  @relation("DriverRatings", fields: [driverId], references: [id])

  @@map("ratings")
}

// ═══════════════════════════════════════════════════════════
// SOCIAL — profile walls, posts, comments, reactions (Facebook-like)
// ═══════════════════════════════════════════════════════════

enum SocialAuthorType {
  FARMER
  BUYER
}

enum PostMediaType {
  NONE
  IMAGE
  VIDEO
}

model SocialPost {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Polymorphic author — farmerId OR buyerId (no FK; resolved by authorType)
  authorType  SocialAuthorType
  authorId    String           @db.Uuid
  /// Denormalized for cheap feed rendering without cross-table joins
  authorName  String           @db.VarChar(255)
  authorAvatar String?         @db.VarChar(500)

  content     String

  /// Image or video URLs. Today these are pasted links; a later upload
  /// pipeline (MinIO) will populate the same field with hosted URLs.
  mediaUrls   String[]
  mediaType   PostMediaType    @default(NONE)

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  comments    PostComment[]
  reactions   PostReaction[]

  @@index([authorType, authorId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("social_posts")
}

model PostComment {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId      String           @db.Uuid
  /// Nested replies — null = top-level comment
  parentId    String?          @db.Uuid

  authorType  SocialAuthorType
  authorId    String           @db.Uuid
  authorName  String           @db.VarChar(255)

  content     String
  createdAt   DateTime         @default(now())

  post        SocialPost       @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent      PostComment?     @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     PostComment[]    @relation("CommentReplies")

  @@index([postId, createdAt])
  @@map("post_comments")
}

model PostReaction {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId      String           @db.Uuid
  authorType  SocialAuthorType
  authorId    String           @db.Uuid
  createdAt   DateTime         @default(now())

  post        SocialPost       @relation(fields: [postId], references: [id], onDelete: Cascade)

  /// One reaction per user per post (toggle like)
  @@unique([postId, authorType, authorId])
  @@map("post_reactions")
}

// ═══════════════════════════════════════════════════════════
// MARKETPLACE BANNERS — admin-managed promotional carousel
// ═══════════════════════════════════════════════════════════

model MarketplaceBanner {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Arabic title (required — primary display language)
  titleAr         String   @db.VarChar(120)
  /// English title (optional — for future bilingual UX)
  titleEn         String?  @db.VarChar(120)

  subtitleAr      String?  @db.VarChar(255)
  subtitleEn      String?  @db.VarChar(255)

  /// Hero image URL (e.g. MinIO/S3 URL). If absent, the UI falls back to `emoji`.
  imageUrl        String?
  emoji           String?  @db.VarChar(8)

  /// Optional CTA URL — internal route ("/marketplace/123") or external link
  linkUrl         String?  @db.VarChar(500)

  /// Tailwind/CSS background class or hex color for the banner card
  backgroundColor String?  @db.VarChar(80)

  /// Target zone. NULL = global (shown to every user regardless of region).
  /// Otherwise the banner is shown only to users whose primary zone (farm /
  /// buyer branch) is in this zone OR a descendant of it.
  geoZoneId       String?  @db.Uuid

  /// Higher = shown earlier in the carousel
  priority        Int      @default(0)

  isActive        Boolean  @default(true)

  /// Optional schedule window. If both are null, banner is always shown
  /// (subject to isActive). If startsAt is set, banner appears from that
  /// moment. If endsAt is set, banner stops being shown after that moment.
  startsAt        DateTime?
  endsAt          DateTime?

  createdById     String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  geoZone         GeoZone? @relation(fields: [geoZoneId], references: [id])

  @@index([isActive, geoZoneId])
  @@index([priority(sort: Desc)])
  @@map("marketplace_banners")
}
