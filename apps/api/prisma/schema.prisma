// ═══════════════════════════════════════════════════════════
// IDENTITY MODULE
// ═══════════════════════════════════════════════════════════

model User {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String    @unique @db.VarChar(255)
  phone             String?   @unique @db.VarChar(20)
  passwordHash      String    @db.VarChar(255)
  userType          UserType
  status            UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt   DateTime?
  phoneVerifiedAt   DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  internalUser      InternalUser?
  farmer            Farmer?
  buyer             Buyer?
  driver            Driver?
  shippingCompany   ShippingCompany?
  sessions          UserSession[]
  notifications     Notification[]

  @@index([userType, status])
  @@map("users")
}

model UserSession {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @db.Uuid
  refreshToken String   @unique @db.VarChar(512)
  ipAddress    String?  @db.VarChar(45)
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

model InternalUser {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String       @unique @db.Uuid
  fullName           String       @db.VarChar(255)
  employeeId         String?      @unique @db.VarChar(50)
  role               InternalRole
  department         String?      @db.VarChar(100)
  directManagerId    String?      @db.Uuid
  zoneAssignments    String[]     @db.Uuid
  shiftStart         String?      @db.VarChar(5)
  shiftEnd           String?      @db.VarChar(5)
  isOnDuty           Boolean      @default(false)
  maxConcurrentTasks Int          @default(10)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  directManager      InternalUser? @relation("ManagerSubordinates", fields: [directManagerId], references: [id])
  subordinates       InternalUser[] @relation("ManagerSubordinates")

  // Tasks & Workflows
  assignedTasks      Task[]       @relation("TaskAssignee")
  createdTasks       Task[]       @relation("TaskCreator")
  escalationsFrom    Escalation[] @relation("EscalationFrom")
  escalationsTo      Escalation[] @relation("EscalationTo")
  approvalRequests   ApprovalRequest[] @relation("ApprovalRequester")
  approvalDecisions  ApprovalRequest[] @relation("ApprovalDecider")

  // Operations
  kycReviews         Farmer[]     @relation("KycReviewer")
  farmersManaged     Farmer[]     @relation("FarmerAccountManager")
  buyersManaged      Buyer[]      @relation("BuyerAccountManager")
  contractsDrafted   SupplyContract[] @relation("ContractDrafter")
  contractsReviewed  SupplyContract[] @relation("ContractReviewer")
  contractsApproved  SupplyContract[] @relation("ContractApprover")
  inspections        QualityInspection[] @relation("Inspector")
  inspectionsSigned  QualityInspection[] @relation("InspectionSupervisor")
  disputesAssigned   Dispute[]    @relation("DisputeAssignee")
  disputesClosed     Dispute[]    @relation("DisputeCloser")
  refundsInitiated   Refund[]     @relation("RefundInitiator")
  refundsApproved    Refund[]     @relation("RefundApprover")
  payoutsApproved    Payout[]     @relation("PayoutApprover")
  penaltiesApproved  PenaltyApplication[] @relation("PenaltyApprover")
  penaltiesWaived    PenaltyApplication[] @relation("PenaltyWaiver")
  repackingInitiated RepackingOrder[] @relation("RepackInitiator")
  repackingApproved  RepackingOrder[] @relation("RepackApprover")
  returnsInitiated   ReturnOrder[] @relation("ReturnInitiator")
  returnsApproved    ReturnOrder[] @relation("ReturnApprover")
  warehousesManaged  Warehouse[]  @relation("WarehouseManager")
  zonesManaged       GeoZone[]    @relation("ZoneManager")
  holdsPlaced        FinancialHold[] @relation("HoldPlacer")
  holdsReleased      FinancialHold[] @relation("HoldReleaser")
  commissionRulesCreated CommissionRule[] @relation("CommissionCreator")
  commissionRulesApproved CommissionRule[] @relation("CommissionApprover")
  scheduledTemplatesApproved ScheduledOrderTemplate[] @relation("TemplateApprover")
  zoneRatesSet       ZoneShippingRate[] @relation("ZoneRateSetter")
  zoneRatesApproved  ZoneShippingRate[] @relation("ZoneRateApprover")

  @@map("internal_users")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(100)
  description String?
  module      String   @db.VarChar(100)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  role         InternalRole
  permissionId String       @db.Uuid

  permission   Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([role, permissionId])
  @@map("role_permissions")
}

model KycDocument {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId        String    @db.Uuid
  ownerType      String    @db.VarChar(50)
  documentType   String    @db.VarChar(100)
  fileUrl        String
  fileName       String?   @db.VarChar(255)
  verified       Boolean   @default(false)
  verifiedBy     String?   @db.Uuid
  verifiedAt     DateTime?
  rejectionReason String?
  expiresAt      DateTime?
  uploadedAt     DateTime  @default(now())

  @@index([ownerId, ownerType])
  @@map("kyc_documents")
}

model Farmer {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String    @unique @db.Uuid
  businessName        String    @db.VarChar(255)
  farmerType          FarmerType
  nationalId          String?   @db.VarChar(50)
  commercialRegNo     String?   @db.VarChar(100)
  contactPersonName   String    @db.VarChar(255)
  contactPhone        String    @db.VarChar(20)
  bankAccountIban     String?   @db.VarChar(34)
  bankName            String?   @db.VarChar(100)
  kycStatus           KycStatus @default(PENDING)
  kycReviewedById     String?   @db.Uuid
  kycReviewedAt       DateTime?
  kycRejectionReason  String?
  creditScore         Decimal?  @db.Decimal(5, 2)
  ratingAvg           Decimal?  @db.Decimal(3, 2)
  ratingCount         Int       @default(0)
  accountManagerId    String?   @db.Uuid
  onboardedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kycReviewer         InternalUser? @relation("KycReviewer", fields: [kycReviewedById], references: [id])
  accountManager      InternalUser? @relation("FarmerAccountManager", fields: [accountManagerId], references: [id])

  farms               FarmerFarm[]
  catalogItems        FarmerCatalogItem[]
  inventoryLots       InventoryLot[]
  orderItems          OrderItem[]
  contractsAsFarmer   SupplyContract[] @relation("FarmerContracts")
  penaltyApplications PenaltyApplication[]
  ratings             Rating[]          @relation("FarmerRatings")
  payouts             Payout[]

  @@index([kycStatus])
  @@map("farmers")
}

model FarmerFarm {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  farmerId        String   @db.Uuid
  farmName        String   @db.VarChar(255)
  geoZoneId       String   @db.Uuid
  address         String
  latitude        Decimal  @db.Decimal(10, 8)
  longitude       Decimal  @db.Decimal(11, 8)
  areaHectares    Decimal? @db.Decimal(10, 2)
  primaryProducts String[]
  isPrimary       Boolean  @default(false)
  createdAt       DateTime @default(now())

  farmer          Farmer   @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  geoZone         GeoZone  @relation(fields: [geoZoneId], references: [id])
  catalogItems    FarmerCatalogItem[]
  inventoryLots   InventoryLot[]
  followers       FarmFollow[]

  @@index([geoZoneId])
  @@map("farmer_farms")
}

model Buyer {
  id                  String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String      @unique @db.Uuid
  businessName        String      @db.VarChar(255)
  buyerType           BuyerType
  commercialRegNo     String?     @db.VarChar(100)
  contactPersonName   String      @db.VarChar(255)
  contactPhone        String      @db.VarChar(20)
  accountTier         AccountTier @default(STANDARD)
  creditLimit         Decimal     @default(0) @db.Decimal(15, 2)
  creditUsed          Decimal     @default(0) @db.Decimal(15, 2)
  paymentTermsDays    Int         @default(0)
  kycStatus           KycStatus   @default(PENDING)
  creditScore         Decimal?    @db.Decimal(5, 2)
  ratingAvg           Decimal?    @db.Decimal(3, 2)
  accountManagerId    String?     @db.Uuid
  onboardedAt         DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountManager      InternalUser? @relation("BuyerAccountManager", fields: [accountManagerId], references: [id])

  branches            BuyerBranch[]
  orders              Order[]
  contractsAsBuyer    SupplyContract[] @relation("BuyerContracts")
  scheduledTemplates  ScheduledOrderTemplate[]
  ratings             Rating[]        @relation("BuyerRatings")
  payouts             Payout[]        @relation("BuyerPayouts")
  followedFarms       FarmFollow[]

  @@index([kycStatus])
  @@index([accountTier])
  @@map("buyers")
}

model BuyerBranch {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  buyerId         String   @db.Uuid
  branchName      String   @db.VarChar(255)
  branchCode      String?  @db.VarChar(50)
  geoZoneId       String   @db.Uuid
  address         String
  latitude        Decimal? @db.Decimal(10, 8)
  longitude       Decimal? @db.Decimal(11, 8)
  contactName     String?  @db.VarChar(255)
  contactPhone    String?  @db.VarChar(20)
  deliveryNotes   String?
  isPrimary       Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  buyer           Buyer    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  geoZone         GeoZone  @relation(fields: [geoZoneId], references: [id])
  orders          Order[]
  scheduledTemplates ScheduledOrderTemplate[]

  @@index([buyerId])
  @@index([geoZoneId])
  @@map("buyer_branches")
}

model FarmFollow {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  buyerId   String     @db.Uuid
  farmId    String     @db.Uuid
  createdAt DateTime   @default(now())

  buyer     Buyer      @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  farm      FarmerFarm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@unique([buyerId, farmId])
  @@index([farmId])
  @@map("farm_follows")
}

model ShippingCompany {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @unique @db.Uuid
  companyName      String   @db.VarChar(255)
  commercialRegNo  String?  @db.VarChar(100)
  fleetSize        Int      @default(0)
  hasRefrigerated  Boolean  @default(false)
  kycStatus        KycStatus @default(PENDING)
  bankAccountIban  String?  @db.VarChar(34)
  ratingAvg        Decimal? @db.Decimal(3, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  drivers          Driver[]
  shipments        Shipment[]
  rateCards        CarrierRateCard[]
  payouts          Payout[]

  @@map("shipping_companies")
}

model Driver {
  id                     String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                 String       @unique @db.Uuid
  shippingCompanyId      String?      @db.Uuid
  fullName               String       @db.VarChar(255)
  nationalId             String       @db.VarChar(50)
  licenseNumber          String       @db.VarChar(50)
  licenseExpiry          DateTime     @db.Date
  vehiclePlate           String       @db.VarChar(20)
  vehicleType            VehicleType
  vehicleCapacityKg      Decimal      @db.Decimal(10, 2)
  hasRefrigeration       Boolean      @default(false)
  refrigerationCertExpiry DateTime?   @db.Date
  bankAccountIban        String?      @db.VarChar(34)
  status                 DriverStatus @default(PENDING)
  ratingAvg              Decimal?     @db.Decimal(3, 2)
  ratingCount            Int          @default(0)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  user                   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  shippingCompany        ShippingCompany? @relation(fields: [shippingCompanyId], references: [id])

  zoneAssignments        DriverZoneAssignment[]
  trips                  DriverTrip[]
  shifts                 DriverShift[]
  locations              DriverLocation[]
  shipments              Shipment[]
  bids                   ShipmentBid[]
  payouts                Payout[]
  ratings                Rating[] @relation("DriverRatings")

  @@index([status])
  @@map("drivers")
}

model DriverZoneAssignment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  driverId    String   @db.Uuid
  zoneId      String   @db.Uuid
  canPickup   Boolean  @default(true)
  canDeliver  Boolean  @default(true)
  assignedBy  String?  @db.Uuid
  createdAt   DateTime @default(now())

  driver      Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  zone        GeoZone  @relation(fields: [zoneId], references: [id])

  @@unique([driverId, zoneId])
  @@map("driver_zone_assignments")
}

// ═══════════════════════════════════════════════════════════
// GEO & ZONE MODULE
// ═══════════════════════════════════════════════════════════

model GeoZone {
  id                   String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  zoneCode             String     @unique @db.VarChar(20)
  zoneName             String     @db.VarChar(255)
  zoneNameAr           String?    @db.VarChar(255)
  parentZoneId         String?    @db.Uuid
  zoneLevel            ZoneLevel
  boundaryGeoJson      Json?
  centroidLat          Decimal?   @db.Decimal(10, 8)
  centroidLng          Decimal?   @db.Decimal(11, 8)
  primaryWarehouseId   String?    @db.Uuid
  secondaryWarehouseId String?    @db.Uuid
  coverageStartTime    String?    @db.VarChar(5)
  coverageEndTime      String?    @db.VarChar(5)
  maxOrderWeightKg     Decimal?   @db.Decimal(10, 2)
  status               ZoneStatus @default(ACTIVE)
  managedById          String?    @db.Uuid
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  parentZone           GeoZone?   @relation("ZoneHierarchy", fields: [parentZoneId], references: [id])
  childZones           GeoZone[]  @relation("ZoneHierarchy")
  managedBy            InternalUser? @relation("ZoneManager", fields: [managedById], references: [id])

  farms                FarmerFarm[]
  buyerBranches        BuyerBranch[]
  driverAssignments    DriverZoneAssignment[]
  inventoryLots        InventoryLot[]
  warehouses           Warehouse[]
  ordersAsPickup       Order[]    @relation("OrderPickupZone")
  ordersAsDelivery     Order[]    @relation("OrderDeliveryZone")
  shipmentsAsPickup    Shipment[] @relation("ShipmentPickupZone")
  shipmentsAsDelivery  Shipment[] @relation("ShipmentDeliveryZone")
  shippingRatesFrom    ZoneShippingRate[] @relation("ShippingRateFrom")
  shippingRatesTo      ZoneShippingRate[] @relation("ShippingRateTo")
  capacityLogs         ZoneCapacityLog[]
  scheduledTemplates   ScheduledOrderTemplate[]
  marketplaceBanners   MarketplaceBanner[]

  @@map("geo_zones")
}

model ZoneShippingRate {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fromZoneId   String   @db.Uuid
  toZoneId     String   @db.Uuid
  rateType     String   @db.VarChar(50)
  baseRate     Decimal  @db.Decimal(10, 2)
  perKgRate    Decimal  @db.Decimal(10, 4)
  minCharge    Decimal? @db.Decimal(10, 2)
  maxWeightKg  Decimal? @db.Decimal(10, 2)
  vehicleType  VehicleType?
  isActive     Boolean  @default(true)
  effectiveFrom DateTime @db.Date
  effectiveUntil DateTime? @db.Date
  setById      String?  @db.Uuid
  approvedById String?  @db.Uuid
  createdAt    DateTime @default(now())

  fromZone     GeoZone  @relation("ShippingRateFrom", fields: [fromZoneId], references: [id])
  toZone       GeoZone  @relation("ShippingRateTo", fields: [toZoneId], references: [id])
  setBy        InternalUser? @relation("ZoneRateSetter", fields: [setById], references: [id])
  approvedBy   InternalUser? @relation("ZoneRateApprover", fields: [approvedById], references: [id])

