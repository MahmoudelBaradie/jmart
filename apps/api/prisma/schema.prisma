  failureReason       String?
  createdAt           DateTime     @default(now())

  batch               PayoutBatch? @relation(fields: [payoutBatchId], references: [id])
  order               Order?          @relation(fields: [orderId], references: [id])
  invoice             Invoice?        @relation(fields: [invoiceId], references: [id])
  approvedBy          InternalUser?   @relation("PayoutApprover", fields: [approvedById], references: [id])
  farmer              Farmer?         @relation(fields: [farmerId], references: [id])
  shippingCompany     ShippingCompany? @relation(fields: [shippingCompanyId], references: [id])
  driver              Driver?         @relation(fields: [driverId], references: [id])
  buyer               Buyer?          @relation("BuyerPayouts", fields: [buyerId], references: [id])

  @@index([recipientId, recipientType])
  @@index([status])
  @@map("payouts")
}

